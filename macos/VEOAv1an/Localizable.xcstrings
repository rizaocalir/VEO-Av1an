    "Girdi: mp4, mkv, mov, avi, webm — ffprobe'nin okuduğu her format." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Input: mp4, mkv, mov, avi, webm — any format ffprobe can read." } }
      }
    },
    "En sorunsuz girdi: yuv420p piksel formatı ve çift sayılı en/boy (örn. 1920x1080)." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Smoothest input: yuv420p pixel format and even width/height (e.g. 1920x1080)." } }
      }
    },
    "Çıktı .mp4 veya .mkv olabilir — .mp4 her oynatıcıda açılır (kayıpsız remux ile üretilir)." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Output can be .mp4 or .mkv — .mp4 plays everywhere (produced via lossless remux)." } }
      }
    },
    "Analiz süresi video uzadıkça artar — VEO her segmenti birkaç kez deneme kodlaması yapar." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Analysis takes longer for longer videos — VEO trial-encodes each segment several times." } }
      }
    },
    "Diskte kaynak boyutunun birkaç katı boş alan bırak (geçici parça dosyaları için)." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep several times the source size free on disk (for temporary chunk files)." } }
      }
    },
    "veo ve av1an uygulamanın içinde gömülü; ayrıca kurulum gerekmez. ffprobe sistemde kurulu olmalı (brew install ffmpeg)." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "veo and av1an are bundled inside the app; no install needed. ffprobe must be installed on the system (brew install ffmpeg)." } }
      }
    },
