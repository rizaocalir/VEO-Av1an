          "stringUnit": {
            "state": "translated",
            "value": "Analysis"
          }
        }
      }
    },
    "Analiz süresi video uzadıkça artar — VEO her segmenti birkaç kez deneme kodlaması yapar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis takes longer for longer videos — VEO trial-encodes each segment several times."
          }
        }
      }
    },
    "Anladım": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got it"
          }
        }
      }
    },
